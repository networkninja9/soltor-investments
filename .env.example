# Copy to .env locally. Never commit actual secrets.
DATABASE_URL="file:./dev.db"
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-bytes"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-strong-password"

# Payments: integrate a licensed processor only after legal/compliance approval.
PAYMENT_PROVIDER="disabled"
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# KYC: use a regulated vendor; keep raw identity documents with the vendor where possible.
KYC_PROVIDER="disabled"
KYC_API_KEY=""
KYC_WEBHOOK_SECRET=""

# Email / monitoring
EMAIL_PROVIDER="disabled"
SENTRY_DSN=""
