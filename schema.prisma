generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INVESTOR
  ADMIN
  COMPLIANCE
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  DISTRIBUTION
  FEE
  ADJUSTMENT
}

enum TransactionStatus {
  REQUESTED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REQUIRES_REVIEW
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String
  role            UserRole     @default(INVESTOR)
  isActive        Boolean      @default(true)
  mfaEnabled      Boolean      @default(false)
  kycStatus       KycStatus    @default(NOT_STARTED)
  organization    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  transactions    Transaction[]
  portfolios      Portfolio[]
  auditEvents     AuditEvent[] @relation("ActorAuditEvents")
  contentEdits    ContentPage[] @relation("ContentEditor")
}

model Portfolio {
  id                String   @id @default(cuid())
  investorId        String
  name              String
  currency          String   @default("USD")
  // Snapshot only; never present as live valuation without a valuation process.
  reportedValueMinor Int     @default(0)
  valuationAsOf     DateTime?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  investor          User     @relation(fields: [investorId], references: [id])
  @@index([investorId])
}

model Transaction {
  id                 String            @id @default(cuid())
  investorId         String
  type               TransactionType
  status             TransactionStatus @default(REQUESTED)
  amountMinor        Int
  currency           String            @default("USD")
  reference          String?           @unique
  providerReference  String?
  description        String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  investor           User              @relation(fields: [investorId], references: [id])
  @@index([investorId, createdAt])
  @@index([status, createdAt])
}

model ContentPage {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String?
  body        String
  status      ContentStatus @default(DRAFT)
  editedById  String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  editedBy    User?         @relation("ContentEditor", fields: [editedById], references: [id])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetType  String
  targetId    String?
  metadata    String?
  ipHash      String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("ActorAuditEvents", fields: [actorId], references: [id])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model PaymentWebhookEvent {
  id          String   @id
  provider    String
  eventType   String
  processedAt DateTime @default(now())
}
